<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The connector add-on's Windows service "POSitiveAnywhereConnectors"
       (docs/connectors/WOOCOMMERCE-CONNECTOR.md §0): hosts the connector
       worker, GET /health and the /hooks/* receivers on loopback
       (default http://localhost:5220). Talks to POSitive ONLY through the
       public /api/v2 — it must never reference PA.Core or open the POSitive
       database. Released separately from PA.Server. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationIcon>..\assets\icon\PositiveAnywhereV2.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PA.Connectors.Core\PA.Connectors.Core.csproj" />
    <ProjectReference Include="..\PA.Connectors.WooCommerce\PA.Connectors.WooCommerce.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PA.Tests" />
    <!-- The connector tests' project in the public, MIT-licensed source of the connector. -->
    <InternalsVisibleTo Include="PA.Connectors.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- S5 connector pages, embedded (served by Ui/ConnectorUiAssets at /connectors/). Not
         static web assets: the service's content root is the exe folder, and an embedded page
         cannot be swapped on disk. -->
    <Content Remove="Ui\Pages\**" />
    <None Remove="Ui\Pages\**" />
    <EmbeddedResource Include="Ui\Pages\*" LogicalName="ConnectorUi.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Its own settings file name, NOT appsettings.json: the add-on may be
         installed beside PA.Server, whose appsettings.json must never be read
         by this host (ConnectorHostApp swaps the default sources). -->
    <Content Update="connectorhost*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
